# Copy this file to .env (same directory as docker-compose.yml) before
# running `docker compose up -d`. docker compose loads .env automatically
# and substitutes ${POSTGRES_PASSWORD} into docker-compose.yml.
#
# Generate a strong password instead of leaving the placeholder, e.g.:
#   openssl rand -hex 16
POSTGRES_PASSWORD=changeme-generate-a-strong-password

# Optional: pin a specific published image tag instead of the mutable
# "latest" (ghcr.io/obzly/obzly, e.g. v1.1.0; amd64 and arm64). Only used
# if your docker-compose.yml references ${OBZLY_IMAGE_TAG} - the
# docker-compose.yml.example in this repo builds from source instead, so it
# ignores this var; install-obzly.sh's generated compose file uses it.
OBZLY_IMAGE_TAG=latest

# Optional: email for the bootstrap super-admin account (default "admin").
# Changing this after the account already exists renames it in place on
# the next restart, it doesn't create a second admin. Both
# docker-compose.yml.example and install-obzly.sh's generated compose
# file pass this through to the container.
ADMIN_EMAIL=

# Optional: only needed if you uncommented the minio/minio-init services in
# docker-compose.yml.example to test the cold-tier object storage path
# locally. Generate a real password the same way as POSTGRES_PASSWORD above
# - MinIO's root user doubles as the AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# pair the obzly service authenticates to it with.
MINIO_ROOT_USER=obzly-minio-admin
MINIO_ROOT_PASSWORD=changeme-generate-a-strong-password

# Only for docker-compose.ha.yml.example: long random strings shared by the
# JetStream broker and its clients (NATS_TOKEN) and by the api replicas and
# the query executors (QUERIER_TOKEN). Generate each with:
#   openssl rand -hex 32
NATS_TOKEN=
QUERIER_TOKEN=
