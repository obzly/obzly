          <mxGeometry x="290" y="640" width="210" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Uploader&#10;(pushes segments&#10;to cold tier)&#10;· runs inline in compactor's pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="210" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="Reconciliation Worker&#10;(restores missing local&#10;segments from cold tier)&#10;· worker mode, leader-locked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="640" width="210" height="118" as="geometry" />
        </mxCell>
