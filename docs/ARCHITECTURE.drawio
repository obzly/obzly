        </mxCell>
        <mxCell id="ms7" value="SiteTokenService&#10;(Valkey cache, encrypted,&#10;singleflight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ms8" value="ProxyController&#10;/sites/{id}/api/v1/*&#10;denylist→allowlist, header hygiene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="370" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ms9" value="Control plane's own&#10;Postgres + Valkey" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;boundedLbl=1;size=15;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="480" height="70" as="geometry" />
        </mxCell>

        <mxCell id="siteA" value="Site A — unchanged single-site deployment&#10;own Postgres/Valkey, projects, plans, API keys,&#10;root admin, local MFA/break-glass&#10;+ POST /api/v1/auth/site/exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="siteB" value="Site B — unchanged single-site deployment&#10;own Postgres/Valkey, projects, plans, API keys,&#10;root admin, local MFA/break-glass&#10;+ POST /api/v1/auth/site/exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="810" width="560" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ingestNote" value="Ingest (OTLP HTTP/gRPC, remote-write, log receiving) stays regional —&#10;reachable by collectors directly, never proxied through the control plane." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="1180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="me1" value="central session (Bearer)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms1" target="ms2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ms2" target="ms3"><mxGeometry relative="1" as="geometry" /></mxCell>
