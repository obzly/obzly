        <mxCell id="ms6" value="AssertionService&#10;(mint ES256 assertion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1">
