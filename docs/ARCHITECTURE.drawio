  <diagram name="Query path" id="obzly-query-path">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="qtitle" value="Query path - partitioned, streamed search (after OpenObserve)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;Logs page&lt;/b&gt;&lt;br&gt;streamed search (NDJSON),&lt;br&gt;rows render per window;&lt;br&gt;total = histogram buckets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="&lt;b&gt;Control plane&lt;/b&gt;&lt;br&gt;/sites/{id}/api/v1 proxy&lt;br&gt;streams (FlushInterval -1),&lt;br&gt;waits 180 s for a Site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;api replica - coordinator&lt;/b&gt;&lt;br&gt;1. plan segments from the catalog&lt;br&gt;2. time windows newest-first:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;5 min, 20 min, 80 min, 5 h, 21 h, 3.5 d ...&lt;br&gt;3. one fragment query per window,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;LIMIT = rows still needed&lt;br&gt;4. stop when the page is full&lt;br&gt;5. stream rows; 170 s deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="q4" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;partition result cache:&lt;br&gt;histogram / dashboard counts&lt;br&gt;per finished hour (not the&lt;br&gt;newest 5 min), TTL 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="q5" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;stream_segments catalog&lt;br&gt;(min/max time, size, stats,&lt;br&gt;object key, writer id)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="250" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q6" value="&lt;b&gt;NATS (broker)&lt;/b&gt;&lt;br&gt;executor discovery + fragment dispatch&lt;br&gt;obzly.segments.uploaded notices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q7" value="&lt;b&gt;querier executors (N)&lt;/b&gt;&lt;br&gt;DuckDB; segments by rendezvous on a&lt;br&gt;stable affinity id (volume's .writer-id)&lt;br&gt;persistent cache volume (optional)&lt;br&gt;warm-up on start + pre-fetch on upload&lt;br&gt;ID search: skip segments whose token&lt;br&gt;bloom filter lacks the ID; results gRPC :4319" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="620" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="q8" value="&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;Parquet segments (S3)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="860" y="650" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q9" value="&lt;b&gt;uploaders&lt;/b&gt; (worker / api)&lt;br&gt;build token bloom filter,&lt;br&gt;upload segment + filter,&lt;br&gt;publish an upload notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="860" y="470" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qe1" value="POST /logs/query/stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe2" value="proxy (streams)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="q3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe3" value="histogram partitions get / put" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="q4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe4" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="q5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe5" value="fragments per window" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="q6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe6" value="dispatch + pre-fetch notices" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q6" target="q7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe7" value="Parquet results&lt;br&gt;(gRPC :4319)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7" target="q3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="685" /><mxPoint x="330" y="360" /></Array><mxPoint x="-10" y="60" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="qe8" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q7" target="q8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe9" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q9" target="q8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe10" value="notice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q9" target="q6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnote" value="A 7-day search for the newest 200 rows reads its first windows only (the newest minutes to hours); older windows are never downloaded or scanned. Deep offsets (&gt; 10 000) still read the range at once." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="260" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Synthetics and cloud" id="obzly-synthetics-cloud"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sctitle" value="Obzly — Synthetics, Infrastructure and cloud connections (v0.56.0)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1250" height="40" as="geometry"/></mxCell><mxCell id="scBrowser" value="Browser&#10;Synthetics · Infrastructure ·&#10;Settings → Cloud connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="230" height="70" as="geometry"/></mxCell><mxCell id="scCP" value="Control plane" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="740" height="370" as="geometry"/></mxCell><mxCell id="scMon" value="Monitors&#10;folders, dependencies (parent_ids),&#10;alerts per monitor (channels)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="215" width="220" height="80" as="geometry"/></mxCell><mxCell id="scGroups" value="Probe groups&#10;one token, many instances;&#10;members heartbeat (60 s live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="215" width="220" height="80" as="geometry"/></mxCell><mxCell id="scDest" value="Destinations&#10;Site project OTLP URL +&#10;encrypted ingest key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSi