        <mxCell id="me4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ms4" target="ms5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me5" value="resolves grant, mints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms4" target="ms6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ms5" target="ms6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me7" value="assertion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms6" target="ms7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me8" value="site token (1h, cached)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms7" target="ms8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me9" value="proxied request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms2" target="ms8">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="410" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ms3" target="ms9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ms4" target="ms9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me12" value="POST /api/v1/auth/site/exchange&#10;(server-to-server, ES256 assertion)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.304;entryY=0;" edge="1" parent="1" source="ms7" target="siteA">
          <mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="720"/><mxPoint x="230" y="720"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="me13" value="Bearer &lt;site token&gt;&#10;/api/v1/... (proxied)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.411;entryY=0;" edge="1" parent="1" source="ms8" target="siteA">
          <mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="770"/><mxPoint x="290" y="770"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="me14" value="Bearer &lt;site token&gt;&#10;/api/v1/... (proxied)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ms8" target="siteB"><mxGeometry x="-0.55" relative="1" as="geometry"></mxGeometry></mxCell>

      <mxCell id="ms10" value="Synthetics + cloud connections&#10;monitors, probe groups,&#10;destinations, cloud_connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="ms11" value="Shared-config document&#10;channels, email, monitor alerts&#10;(signed, sealed per Site)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="ms12" value="Cloud federation key (RS256)&#10;+ /.well-known/openid-configuration&#10;(AWS / Azure trust it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="me15" value="pulls every 5 min" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.741;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="siteA" target="ms11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me16" value="pulls every 5 min" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.143;exitY=0;entryX=0.696;entryY=1;" edge="1" parent="1" source="siteB" target="ms11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="690"/><mxPoint x="520" y="690"/></Array></mxGeometry></mxCell><mxCell id="me17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ms10" target="ms9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="495"/></Array></mxGeometry></mxCell><mxCell id="me18" value="monitor alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ms10" target="ms11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
    </mxGraphModel>
