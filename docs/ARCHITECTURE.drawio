        </mxCell>
        <mxCell id="s2" value="2 · Obzly Application — single binary; SERVICE_MODE=api (request-serving) + worker (background), leader-locked via Valkey for HA (default &quot;all&quot; runs both in one process)" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
