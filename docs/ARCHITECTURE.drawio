        </mxCell>
        <mxCell id="s3" value="3 · External Dependencies (Postgres &amp; Valkey are external services; object storage is optional)" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
