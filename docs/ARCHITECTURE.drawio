      <mxCell id="n0probe" value="obzly-probe groups&#10;(Synthetics checks,&#10;cloud scans; OTLP results)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="190" height="90" as="geometry"/></mxCell><mxCell id="n26" value="Alerting&#10;(evaluator, outbox, managed&#10;rules) · worker mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="210" height="85" as="geometry"/></mxCell><mxCell id="n27" value="Inventory builder&#10;(agents + cloud_resource_info,&#10;every 5 min) · worker mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="780" width="210" height="85" as="geometry"/></mxCell><mxCell id="n28" value="Shared config from the&#10;control plane (channels, email,&#10;monitor alert rules)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="780" width="210" height="85" as="geometry"/></mxCell><mxCell id="e34" value="OTLP/HTTP results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.13;entryY=0;" edge="1" parent="1" source="n0probe" target="n6"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="325"/><mxPoint x="68" y="325"/></Array></mxGeometry></mxCell><mxCell id="e35" value="inventory_assets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.304;entryY=0;" edge="1" parent="1" source="n27" target="n22"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="1005"/><mxPoint x="760" y="1005"/></Array></mxGeometry></mxCell><mxCell id="e36" value="rules, states, outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.13;entryY=0;" edge="1" parent="1" source="n26" target="n22"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="1025"/><mxPoint x="720" y="1025"/></Array></mxGeometry></mxCell><mxCell id="e37" value="managed rules, channels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n28" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="880"/><mxPoint x="270" y="880"/><mxPoint x="270" y="822"/></Array></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram name="Multi-site" id="obzly-multisite-overview">
