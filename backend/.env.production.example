# Production defaults - copied into the image as /app/.env. Uncommented
# lines here are image defaults; everything else is commented out.
# Every setting, with defaults: docs/configuration.md.
# No credentials here: the deployment sets DATABASE_DSN (and any password),
# so a missing one stops startup instead of using a placeholder.
#app
ENV_MODE=production
# db - required, set by the deployment, e.g.:
#   DATABASE_DSN=host=postgres user=postgres password=<DB_PASSWORD> dbname=obzly port=5432 sslmode=disable
# migrations (run at startup with DATABASE_DSN)
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations
# valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_IS_SSL=false
# logs storage engine (ARCHITECTURE.md) - defaults to /obzly-data/segments
# if unset, matching the VOLUME declared in the Dockerfile.
LOGS_DATA_DIR=/obzly-data/segments
# object storage cold tier - leave unset for local-disk-only (the default).
# Set to a gocloud.dev/blob bucket URL to enable it, e.g.:
#   OBJECT_STORAGE_URL=s3://my-bucket
#   OBJECT_STORAGE_URL=gs://my-bucket
#   OBJECT_STORAGE_URL=azblob://my-container
# s3blob (real AWS S3 or any S3-compatible endpoint, e.g. MinIO for local/
# test use - see docker-compose.yml.example's commented minio service) is
# blank-imported in cmd/main.go already; GCS/Azure need the matching driver
# blank-imported there too - file:// and mem:// work out of the box.
# For MinIO specifically:
#   OBJECT_STORAGE_URL=s3://my-bucket?endpoint=http://minio:9000&region=us-east-1&use_path_style=true&disable_https=true&hostname_immutable=true
#   AWS_ACCESS_KEY_ID=<MinIO root user>
#   AWS_SECRET_ACCESS_KEY=<MinIO root password>
OBJECT_STORAGE_URL=
# Main HTTP port - UI, REST API and OTLP/HTTP (POST /v1/logs etc.) all share
# it. Defaults to 4005 if unset. If you change it, change the container
# port mapping / Kubernetes containerPort to match; the image's own health
# check follows it automatically.
HTTP_PORT=4005
# OTLP gRPC logs receiver port (ARCHITECTURE.md, Phase 3) - defaults to 4317
# (the OTel-conventional collector gRPC port) if unset. OTLP/HTTP shares the
# main app port instead (POST /v1/logs), no separate config needed for it.
OTLP_GRPC_PORT=4317
# CIDR(s) of the reverse proxy / load balancer in front of obzly whose
# X-Forwarded-For is trusted (e.g. your VPC CIDR behind an AWS ALB, or the
# Docker network shared with Nginx Proxy Manager). Empty = nothing trusted,
# so logs, the audit log, rate limiting and IP allow-lists all see the
# proxy's IP instead of the real client. Never 0.0.0.0/0.
TRUSTED_PROXIES=
# oauth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email for the bootstrap super-admin account (the one `./main
# --email="..."` resets, prompting for the password, and the only account that can
# activate/deactivate/promote other Admin-role users). Leave unset to keep
# the default: "admin", or "superadmin" when SERVICE_MODE=control-plane (a
# control plane's break-glass account must not share an email with any
# Site's root admin - see the multi-site section below). Changing this
# after the account already exists renames it in place on next startup -
# it does not create a second admin.
ADMIN_EMAIL=

# --- Multi-site (ARCHITECTURE.md "Multi-site: control plane and Sites") ---
# Every var below is optional and unset by default: a plain SERVICE_MODE
# (all/api/worker) install with none of these set is exactly the single-site
# instance it always was. Set SERVICE_MODE=control-plane and the PUBLIC_URL
# block to run this deployment AS a control plane instead; set the SITE_ID/
# CONTROL_PLANE_ISSUER block to enroll this deployment (any SERVICE_MODE that
# serves HTTP) AS a Site behind one. A process is never both.

# Control-plane side - required when SERVICE_MODE=control-plane, ignored
# otherwise:
#
# PUBLIC_URL is the browser-facing origin (scheme + host[:port], no path).
# Any install: OAuth metadata for MCP clients (else taken from the request).
# A control plane: also the `iss` of every token-exchange assertion it
# signs; every Site's own CONTROL_PLANE_ISSUER must match this exactly.
# PUBLIC_URL=https://control-plane.example.com
#
# Lets you register a Site with an http:// (not https://) api_url - only for
# a local/internal-network-only setup like docker-compose.multisite.yml.example;
# never enable this on a control plane reachable from the internet.
# SITE_ALLOW_INSECURE_URLS=false
#
# Comma-separated CIDRs this control plane restricts its own outbound calls
# to a Site (token exchange + the reverse proxy) to. Empty = any non-
# loopback, non-link-local address (the SSRF floor that always applies).
# CONTROL_PLANE_EGRESS_ALLOWLIST=

# Site side - required when CONTROL_PLANE_ISSUER is set, ignored otherwise:
#
# SITE_ID is this Site's identity inside the control plane - the slug an
# admin registers it under, and the `aud` every assertion for it carries.
# SITE_ID=site-a
#
# Human-readable label surfaced by GET /api/v1/site/info - defaults to
# SITE_ID.
# SITE_NAME=Site A
#
# The exact `iss` value assertions must carry - i.e. the control plane's
# PUBLIC_URL above. Unset (the default) means this Site is standalone and
# POST /api/v1/auth/site/exchange answers 404.
# CONTROL_PLANE_ISSUER=https://control-plane.example.com
#
# Where this Site fetches the control plane's signing keys from - defaults
# to "<CONTROL_PLANE_ISSUER>/.well-known/jwks.json". Override only if this
# Site should reach the control plane over a different address than the
# public issuer (an internal/VPC-only DNS name, a compose service name).
# CONTROL_PLANE_JWKS_URL=
#
# Whether a centrally-authenticated user with no linked local identity may
# be attached to an EXISTING local account with the same verified email -
# the "existing single-site install becomes a Site" migration path. Default
# true; set false to force every central user onto a fresh local account
# instead. Never applies to the local root admin regardless.
# CONTROL_PLANE_LINK_BY_EMAIL=true
#
# Comma-separated CIDRs the control plane's outbound calls arrive from -
# restricts POST /api/v1/auth/site/exchange to just that source. Optional;
# the assertion's own signature/aud/exp checks always apply regardless.
# CONTROL_PLANE_EGRESS_CIDRS=

# --- Alerting (Phase 14 item 8) ---
# Webhook, Slack and PagerDuty notifications only reach public addresses.
# ALERT_EGRESS_ALLOWLIST opts private CIDRs back in (in-network receivers);
# ALERT_EGRESS_DENYLIST blocks CIDRs outright (e.g. the cluster's service
# range, which the binary can't discover).
# ALERT_EGRESS_ALLOWLIST=
# ALERT_EGRESS_DENYLIST=
# Rule evaluation is split this many ways, each under its own leader lock.
# ALERT_EVAL_SHARDS=1
# Email (SMTP) and notification channels are set up in Obzly settings;
# ALERT_SMTP_* from older releases is imported once, then ignored.

# --- Roles and scale-out (ARCHITECTURE.md "Scale architecture") ---
# One image, one role per process: all (default), api, worker, broker,
# querier, control-plane. deploy/docker/docker-compose.ha.yml.example and
# deploy/helm/obzly set these per role.
# SERVICE_MODE=all
# Durable ingest: acknowledge a batch once the JetStream brokers hold it
# (in-process in SERVICE_MODE=all).
# INGEST_BUFFER=jetstream
# NATS_URL=nats://broker-1:4222,nats://broker-2:4222,nats://broker-3:4222
# NATS_TOKEN=<long random string>
# Brokers only: unique name, cluster name and every broker's route.
# NATS_SERVER_NAME=broker-1
# NATS_CLUSTER_NAME=obzly
# NATS_ROUTES=nats-route://broker-1:6222,nats-route://broker-2:6222,nats-route://broker-3:6222
# JETSTREAM_REPLICAS=3
# Each signal's buffer (default 10 GiB); when full, ingest answers 429.
# INGEST_STREAM_MAX_BYTES=10737418240
# A worker writes a first-level segment at 64 MiB or after an hour.
# INGEST_L0_TARGET_BYTES=67108864
# INGEST_L0_MAX_AGE=1h
# Query executors: api and querier share the token; the advertise address
# is how api replicas reach this querier.
# QUERIER_TOKEN=<long random string>
# QUERIER_GRPC_ADDR=:4319
# QUERIER_ADVERTISE_ADDR=querier-1:4319
# Most stored data one user query may read (GiB; 0 = no limit).
# QUERY_MAX_SCAN_GB=100
# Local cache of segments read back from object storage.
# COLD_CACHE_MAX_SIZE_MB=20000
# Seconds a replica keeps serving after SIGTERM (15 behind a load balancer).
# SHUTDOWN_DRAIN_SECONDS=0

# --- Self-observability (deploy/observability) ---
# Prometheus /metrics on an internal port ("off" disables it).
# METRICS_ADDR=:9464
# Share of this replica's own work traced into the system project.
# SELF_TRACING_SAMPLE_RATE=0.01

# --- Integrity audit (docs/runbooks/backup-restore.md) ---
# With object storage: a sample of uploaded segments checked weekly.
# INTEGRITY_AUDIT_HOURS=168
# INTEGRITY_AUDIT_PERCENT=1
# INTEGRITY_AUDIT_MAX_SAMPLES=500
