# docker-compose.yml
DEV_DB_NAME=obzly
DEV_DB_USERNAME=postgres
DEV_DB_PASSWORD=Q1234567
#app
ENV_MODE=development
# db
DATABASE_DSN=host=dev-db user=postgres password=Q1234567 dbname=obzly port=5437 sslmode=disable
DATABASE_URL=postgres://postgres:Q1234567@dev-db:5437/obzly?sslmode=disable
# migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:Q1234567@dev-db:5437/obzly?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
# valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_IS_SSL=false
# logs storage engine (ARCHITECTURE.md) - defaults to /obzly-data/segments
# if unset; override for local dev so it lands next to pgdata/valkey-data.
LOGS_DATA_DIR=./obzly-data/segments
# object storage cold tier - leave unset for local-disk-only (the default).
OBJECT_STORAGE_URL=
# OTLP gRPC logs receiver port (ARCHITECTURE.md, Phase 3) - defaults to 4317 if unset.
OTLP_GRPC_PORT=4317
# oauth
GITHUB_CLIENT_ID=test
GITHUB_CLIENT_SECRET=test
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
